    "cloud_contacts_account_delete_hint_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account deletion is a separate choice in Me. It removes your private data everywhere; deleting or blocking a contact only changes that relationship."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除账号是“我的”页里的独立操作，会移除你在所有地方的私人数据；删除或拉黑联系人只改变与该联系人的关系。"
          }
        }
      }
    },
